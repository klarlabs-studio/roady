# Binaries
/roady
/roady-plugin-*
dist/
# ...but not the built MCP App UIs. They are generated, yet they are also
# //go:embed inputs, so the package does not compile without them. The bare
# `dist/` rule above silently swallowed new files here: the existing ones are
# tracked only because they predate it, which is why ui://roady/billing
# shipped registered-but-missing.
!internal/infrastructure/mcp/dist/
!internal/infrastructure/mcp/dist/**

# OS files
.DS_Store

# Local Roady State
.roady/

# Stray deadletter artifact written when webhook tests run in cwd
deadletters.jsonl

# Coverage and Reports
.cover/
!.cover/history.json
.verdict/
coverage.out
findings.json

# Relicta artifacts
.relicta/

# Local guidance
AGENTS.md

# IDEs
.vscode/
.idea/

# MCP Apps
app/node_modules/
app/dist/
# internal/infrastructure/mcp/dist/ is committed for go:embed

# Website
website/node_modules/
website/dist/
website/.astro/

# Playwright MCP screenshots
.playwright-mcp/

# Claude local settings
.claude/settings.local.json
memory/
