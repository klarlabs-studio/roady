---
import BaseLayout from '../layouts/BaseLayout.astro';
import Navigation from '../components/Navigation.vue';
import Footer from '../components/Footer.astro';
---

<BaseLayout title="Roady | CLI Documentation" description="Complete command reference for the Roady CLI - the planning-first system of record for software work.">
  <Navigation client:load />

  <main class="pt-24 pb-16 min-h-screen">
    <div class="max-w-5xl mx-auto px-6">
      <!-- Header -->
      <div class="mb-12">
        <a href="/roady/" class="inline-flex items-center text-violet-400 hover:text-violet-300 mb-4 transition-colors">
          <i data-lucide="arrow-left" class="w-4 h-4 mr-2"></i>
          Back to Home
        </a>
        <h1 class="text-4xl font-bold text-white mb-4">CLI Reference</h1>
        <p class="text-gray-400 text-lg">Complete command documentation for Roady - the planning-first system of record.</p>
      </div>

      <!-- Quick Navigation -->
      <nav class="glass rounded-2xl p-6 mb-12">
        <h2 class="text-sm font-semibold text-gray-400 uppercase tracking-wider mb-4">Jump to</h2>
        <div class="grid grid-cols-2 md:grid-cols-4 gap-3">
          <a href="#getting-started" class="text-violet-400 hover:text-violet-300 transition-colors">Getting Started</a>
          <a href="#spec-commands" class="text-violet-400 hover:text-violet-300 transition-colors">Spec Commands</a>
          <a href="#plan-commands" class="text-violet-400 hover:text-violet-300 transition-colors">Plan Commands</a>
          <a href="#task-commands" class="text-violet-400 hover:text-violet-300 transition-colors">Task Commands</a>
          <a href="#drift-commands" class="text-violet-400 hover:text-violet-300 transition-colors">Drift</a>
          <a href="#status-commands" class="text-violet-400 hover:text-violet-300 transition-colors">Status & Audit</a>
          <a href="#integration-commands" class="text-violet-400 hover:text-violet-300 transition-colors">Git & MCP</a>
          <a href="#advanced-commands" class="text-violet-400 hover:text-violet-300 transition-colors">Advanced</a>
        </div>
      </nav>

      <!-- Getting Started -->
      <section id="getting-started" class="mb-16">
        <h2 class="text-2xl font-bold text-white mb-6 flex items-center">
          <i data-lucide="rocket" class="w-6 h-6 mr-3 text-emerald-400"></i>
          Getting Started
        </h2>

        <div class="space-y-6">
          <div class="glass rounded-xl p-6">
            <h3 class="text-lg font-semibold text-white mb-2">roady init</h3>
            <p class="text-gray-400 mb-4">Initialize a new Roady project in the current directory.</p>
            <div class="bg-black/40 rounded-lg p-4 mb-4">
              <code class="text-sm text-gray-300">roady init [project-name] [flags]</code>
            </div>
            <h4 class="text-sm font-semibold text-gray-300 mb-2">Flags</h4>
            <table class="w-full text-sm">
              <tr class="border-b border-white/10">
                <td class="py-2 text-violet-300 mono">--interactive</td>
                <td class="py-2 text-gray-400">Prompt for AI configuration after initialization</td>
              </tr>
            </table>
            <div class="mt-4 bg-black/40 rounded-lg p-4">
              <p class="text-xs text-gray-500 mb-2"># Example</p>
              <code class="text-sm text-emerald-300">roady init my-project --interactive</code>
            </div>
          </div>

          <div class="glass rounded-xl p-6">
            <h3 class="text-lg font-semibold text-white mb-2">roady setup</h3>
            <p class="text-gray-400 mb-4">Wire the MCP server, instructions, and session hooks for an agent: claude-code, claude-desktop, codex, gemini, cursor, opencode, copilot, or kiro.</p>
            <div class="bg-black/40 rounded-lg p-4">
              <code class="text-sm text-gray-300 block">roady setup claude-code</code>
            </div>
          </div>

          <div class="glass rounded-xl p-6">
            <h3 class="text-lg font-semibold text-white mb-2">roady next</h3>
            <p class="text-gray-400 mb-4">Brief on the task you are on, or the one to start next. Agent hooks run it at session start.</p>
            <div class="bg-black/40 rounded-lg p-4">
              <code class="text-sm text-gray-300 block">roady next</code>
            </div>
          </div>

          <div class="glass rounded-xl p-6">
            <h3 class="text-lg font-semibold text-white mb-2">roady doctor</h3>
            <p class="text-gray-400 mb-4">Check the health of the Roady environment and validate project setup.</p>
            <div class="bg-black/40 rounded-lg p-4">
              <code class="text-sm text-gray-300">roady doctor</code>
            </div>
          </div>
        </div>
      </section>

      <!-- Spec Commands -->
      <section id="spec-commands" class="mb-16">
        <h2 class="text-2xl font-bold text-white mb-6 flex items-center">
          <i data-lucide="file-text" class="w-6 h-6 mr-3 text-blue-400"></i>
          Spec Commands
        </h2>
        <p class="text-gray-400 mb-6">Manage product specifications - the source of truth for what you're building.</p>

        <div class="space-y-6">
          <div class="glass rounded-xl p-6">
            <h3 class="text-lg font-semibold text-white mb-2">roady spec analyze</h3>
            <p class="text-gray-400 mb-4">Analyze a directory for markdown files and infer a product specification.</p>
            <div class="bg-black/40 rounded-lg p-4 mb-4">
              <code class="text-sm text-gray-300">roady spec analyze [dir] [flags]</code>
            </div>
            <h4 class="text-sm font-semibold text-gray-300 mb-2">Flags</h4>
            <table class="w-full text-sm">
              <tr class="border-b border-white/10">
                <td class="py-2 text-violet-300 mono">--reconcile</td>
                <td class="py-2 text-gray-400">Use AI to semantically deduplicate and reconcile the spec</td>
              </tr>
            </table>
            <div class="mt-4 bg-black/40 rounded-lg p-4">
              <p class="text-xs text-gray-500 mb-2"># Example</p>
              <code class="text-sm text-emerald-300">roady spec analyze docs/ --reconcile</code>
            </div>
          </div>

          <div class="glass rounded-xl p-6">
            <h3 class="text-lg font-semibold text-white mb-2">roady spec add</h3>
            <p class="text-gray-400 mb-4">Quickly add a new feature to the specification.</p>
            <div class="bg-black/40 rounded-lg p-4 mb-4">
              <code class="text-sm text-gray-300">roady spec add [feature-title]</code>
            </div>
            <div class="mt-4 bg-black/40 rounded-lg p-4">
              <p class="text-xs text-gray-500 mb-2"># Example</p>
              <code class="text-sm text-emerald-300">roady spec add "User authentication with OAuth"</code>
            </div>
          </div>

          <div class="glass rounded-xl p-6">
            <h3 class="text-lg font-semibold text-white mb-2">roady spec validate</h3>
            <p class="text-gray-400 mb-4">Validate the current specification structure and content. Also available as <code class="text-violet-300">roady spec lint</code>.</p>
            <div class="bg-black/40 rounded-lg p-4">
              <code class="text-sm text-gray-300">roady spec validate</code>
            </div>
          </div>

          <div class="glass rounded-xl p-6">
            <h3 class="text-lg font-semibold text-white mb-2">roady spec import</h3>
            <p class="text-gray-400 mb-4">Import a spec from a markdown file.</p>
            <div class="bg-black/40 rounded-lg p-4">
              <code class="text-sm text-gray-300">roady spec import [file.md]</code>
            </div>
          </div>

          <div class="glass rounded-xl p-6">
            <h3 class="text-lg font-semibold text-white mb-2">roady spec explain</h3>
            <p class="text-gray-400 mb-4">Get an AI-generated explanation of the current spec.</p>
            <div class="bg-black/40 rounded-lg p-4">
              <code class="text-sm text-gray-300">roady spec explain</code>
            </div>
          </div>
        </div>
      </section>

      <!-- Plan Commands -->
      <section id="plan-commands" class="mb-16">
        <h2 class="text-2xl font-bold text-white mb-6 flex items-center">
          <i data-lucide="git-branch" class="w-6 h-6 mr-3 text-violet-400"></i>
          Plan Commands
        </h2>
        <p class="text-gray-400 mb-6">Manage execution plans - the task DAG derived from your spec.</p>

        <div class="space-y-6">
          <div class="glass rounded-xl p-6">
            <h3 class="text-lg font-semibold text-white mb-2">roady plan generate</h3>
            <p class="text-gray-400 mb-4">Generate a plan from the current spec. Creates tasks with dependencies.</p>
            <div class="bg-black/40 rounded-lg p-4 mb-4">
              <code class="text-sm text-gray-300">roady plan generate [flags]</code>
            </div>
            <h4 class="text-sm font-semibold text-gray-300 mb-2">Flags</h4>
            <table class="w-full text-sm">
              <tr class="border-b border-white/10">
                <td class="py-2 text-violet-300 mono">--ai</td>
                <td class="py-2 text-gray-400">Emit a decomposition prompt instead of generating. Run it with your own model, then write the tasks back with <code class="mono text-violet-400">roady_update_plan</code>.</td>
              </tr>
              <tr class="border-b border-white/10">
                <td class="py-2 text-violet-300 mono">--json</td>
                <td class="py-2 text-gray-400">Emit the prompt request as JSON for an agent to consume</td>
              </tr>
            </table>
            <div class="mt-4 bg-black/40 rounded-lg p-4">
              <p class="text-xs text-gray-500 mb-2"># Examples</p>
              <code class="text-sm text-emerald-300 block">roady plan generate</code>
              <code class="text-sm text-emerald-300 block mt-1">roady plan generate --ai</code>
            </div>
          </div>

          <div class="glass rounded-xl p-6">
            <h3 class="text-lg font-semibold text-white mb-2">roady capture</h3>
            <p class="text-gray-400 mb-4">Record features, requirements, and tasks in one write (YAML or JSON). See docs/capture.md.</p>
            <div class="bg-black/40 rounded-lg p-4">
              <code class="text-sm text-gray-300 block">roady capture -f plan.yaml</code>
            </div>
          </div>

          <div class="glass rounded-xl p-6">
            <h3 class="text-lg font-semibold text-white mb-2">roady plan import</h3>
            <p class="text-gray-400 mb-4">Turn a harness's plan file (Claude Code, Kiro, Codex ExecPlan, markdown) into tasks.</p>
            <div class="bg-black/40 rounded-lg p-4">
              <code class="text-sm text-gray-300 block">roady plan import ~/.claude/plans/my-plan.md --dry-run</code>
            </div>
          </div>

          <div class="glass rounded-xl p-6">
            <h3 class="text-lg font-semibold text-white mb-2">roady plan approve</h3>
            <p class="text-gray-400 mb-4">Approve the current plan for execution. Required before tasks can be started.</p>
            <div class="bg-black/40 rounded-lg p-4">
              <code class="text-sm text-gray-300">roady plan approve</code>
            </div>
          </div>

          <div class="glass rounded-xl p-6">
            <h3 class="text-lg font-semibold text-white mb-2">roady plan reject</h3>
            <p class="text-gray-400 mb-4">Reject the current plan, requiring regeneration.</p>
            <div class="bg-black/40 rounded-lg p-4">
              <code class="text-sm text-gray-300">roady plan reject</code>
            </div>
          </div>

          <div class="glass rounded-xl p-6">
            <h3 class="text-lg font-semibold text-white mb-2">roady plan prune</h3>
            <p class="text-gray-400 mb-4">Remove tasks from the plan that are no longer in the spec.</p>
            <div class="bg-black/40 rounded-lg p-4">
              <code class="text-sm text-gray-300">roady plan prune</code>
            </div>
          </div>
        </div>
      </section>

      <!-- Task Commands -->
      <section id="task-commands" class="mb-16">
        <h2 class="text-2xl font-bold text-white mb-6 flex items-center">
          <i data-lucide="check-square" class="w-6 h-6 mr-3 text-emerald-400"></i>
          Task Commands
        </h2>
        <p class="text-gray-400 mb-6">Manage individual task lifecycle - start, complete, block, and verify.</p>

        <div class="space-y-6">
          <div class="glass rounded-xl p-6">
            <h3 class="text-lg font-semibold text-white mb-2">roady task mine · assigned · unassigned</h3>
            <p class="text-gray-400 mb-4">Answer who is working on what. <code class="mono text-violet-400">mine</code> resolves you from <code class="mono text-violet-400">ROADY_USER</code>, then git <code class="mono text-violet-400">user.name</code>, then <code class="mono text-violet-400">USER</code>.</p>
            <div class="bg-black/40 rounded-lg p-4">
              <code class="text-sm text-gray-300 block">roady task mine</code>
              <code class="text-sm text-gray-300 block mt-1">roady task assigned &lt;name&gt;</code>
              <code class="text-sm text-gray-300 block mt-1">roady task unassigned</code>
            </div>
          </div>

          <div class="glass rounded-xl p-6">
            <h3 class="text-lg font-semibold text-white mb-2">roady task start</h3>
            <p class="text-gray-400 mb-4">Start working on a task. Validates dependencies and WIP limits.</p>
            <div class="bg-black/40 rounded-lg p-4 mb-4">
              <code class="text-sm text-gray-300">roady task start [task-id] [flags]</code>
            </div>
            <h4 class="text-sm font-semibold text-gray-300 mb-2">Flags</h4>
            <table class="w-full text-sm">
              <tr class="border-b border-white/10">
                <td class="py-2 text-violet-300 mono">-e, --evidence</td>
                <td class="py-2 text-gray-400">Evidence for the task (e.g., commit hash, URL)</td>
              </tr>
            </table>
          </div>

          <div class="glass rounded-xl p-6">
            <h3 class="text-lg font-semibold text-white mb-2">roady task complete</h3>
            <p class="text-gray-400 mb-4">Mark a task as completed.</p>
            <div class="bg-black/40 rounded-lg p-4 mb-4">
              <code class="text-sm text-gray-300">roady task complete [task-id] [flags]</code>
            </div>
            <h4 class="text-sm font-semibold text-gray-300 mb-2">Flags</h4>
            <table class="w-full text-sm">
              <tr class="border-b border-white/10">
                <td class="py-2 text-violet-300 mono">-e, --evidence</td>
                <td class="py-2 text-gray-400">Evidence for completion (e.g., commit hash, PR URL)</td>
              </tr>
            </table>
          </div>

          <div class="glass rounded-xl p-6">
            <h3 class="text-lg font-semibold text-white mb-2">roady task block / unblock</h3>
            <p class="text-gray-400 mb-4">Mark a task as blocked or remove the block.</p>
            <div class="bg-black/40 rounded-lg p-4">
              <code class="text-sm text-gray-300 block">roady task block [task-id]</code>
              <code class="text-sm text-gray-300 block mt-1">roady task unblock [task-id]</code>
            </div>
          </div>

          <div class="glass rounded-xl p-6">
            <h3 class="text-lg font-semibold text-white mb-2">roady task stop</h3>
            <p class="text-gray-400 mb-4">Stop working on a task (return to pending).</p>
            <div class="bg-black/40 rounded-lg p-4">
              <code class="text-sm text-gray-300">roady task stop [task-id]</code>
            </div>
          </div>

          <div class="glass rounded-xl p-6">
            <h3 class="text-lg font-semibold text-white mb-2">roady task check</h3>
            <p class="text-gray-400 mb-4">Run a task's acceptance check and record the result as evidence. <code class="mono text-violet-400">roady task verify</code> refuses while the check fails.</p>
            <div class="bg-black/40 rounded-lg p-4">
              <code class="text-sm text-gray-300 block">roady task check [task-id]</code>
            </div>
          </div>

          <div class="glass rounded-xl p-6">
            <h3 class="text-lg font-semibold text-white mb-2">roady task verify</h3>
            <p class="text-gray-400 mb-4">Mark a completed task as verified with evidence.</p>
            <div class="bg-black/40 rounded-lg p-4">
              <code class="text-sm text-gray-300">roady task verify [task-id] --evidence "PR #123 merged"</code>
            </div>
          </div>

          <div class="glass rounded-xl p-6">
            <h3 class="text-lg font-semibold text-white mb-2">roady task reopen</h3>
            <p class="text-gray-400 mb-4">Reopen a completed task if issues are found.</p>
            <div class="bg-black/40 rounded-lg p-4">
              <code class="text-sm text-gray-300">roady task reopen [task-id]</code>
            </div>
          </div>
        </div>
      </section>

      <!-- Drift Commands -->
      <section id="drift-commands" class="mb-16">
        <h2 class="text-2xl font-bold text-white mb-6 flex items-center">
          <i data-lucide="git-compare" class="w-6 h-6 mr-3 text-amber-400"></i>
          Drift Commands
        </h2>
        <p class="text-gray-400 mb-6">Detect and manage drift between specs, plans, and execution.</p>

        <div class="space-y-6">
          <div class="glass rounded-xl p-6">
            <h3 class="text-lg font-semibold text-white mb-2">roady drift detect</h3>
            <p class="text-gray-400 mb-4">Report where intent, plan, and reality have parted company. Exits non-zero when drift is found, so it can gate CI.</p>
            <div class="bg-black/40 rounded-lg p-4 mb-4">
              <code class="text-sm text-gray-300">roady drift detect</code>
            </div>
            <h4 class="text-sm font-semibold text-gray-300 mb-2">What it checks</h4>
            <table class="w-full text-sm">
              <tr class="border-b border-white/10">
                <td class="py-2 text-violet-300 mono">intent</td>
                <td class="py-2 text-gray-400">The spec changed since it was last locked</td>
              </tr>
              <tr class="border-b border-white/10">
                <td class="py-2 text-violet-300 mono">plan</td>
                <td class="py-2 text-gray-400">Requirements with no task, or tasks with no requirement</td>
              </tr>
              <tr class="border-b border-white/10">
                <td class="py-2 text-violet-300 mono">code</td>
                <td class="py-2 text-gray-400">A task marked done whose file is missing or uncommitted</td>
              </tr>
              <tr class="border-b border-white/10">
                <td class="py-2 text-violet-300 mono">stale</td>
                <td class="py-2 text-gray-400">The plan itself has fallen behind — the repository moved on without it</td>
              </tr>
            </table>
          </div>

          <div class="glass rounded-xl p-6">
            <h3 class="text-lg font-semibold text-white mb-2">roady drift accept</h3>
            <p class="text-gray-400 mb-4">Accept current drift by locking the spec snapshot.</p>
            <div class="bg-black/40 rounded-lg p-4">
              <code class="text-sm text-gray-300">roady drift accept</code>
            </div>
          </div>

          <div class="glass rounded-xl p-6">
            <h3 class="text-lg font-semibold text-white mb-2">roady drift explain</h3>
            <p class="text-gray-400 mb-4">Get AI-generated explanation and resolution steps for current drift.</p>
            <div class="bg-black/40 rounded-lg p-4">
              <code class="text-sm text-gray-300">roady drift explain</code>
            </div>
          </div>

        </div>
      </section>

      <!-- Status & Audit Commands -->
      <section id="status-commands" class="mb-16">
        <h2 class="text-2xl font-bold text-white mb-6 flex items-center">
          <i data-lucide="bar-chart-3" class="w-6 h-6 mr-3 text-cyan-400"></i>
          Status & Audit
        </h2>
        <p class="text-gray-400 mb-6">View project status, rebuild state, and inspect the audit trail.</p>

        <div class="space-y-6">
          <div class="glass rounded-xl p-6">
            <h3 class="text-lg font-semibold text-white mb-2">roady status</h3>
            <p class="text-gray-400 mb-4">Show a high-level summary of the project state with optional filtering.</p>
            <div class="bg-black/40 rounded-lg p-4 mb-4">
              <code class="text-sm text-gray-300">roady status [flags]</code>
            </div>
            <h4 class="text-sm font-semibold text-gray-300 mb-2">Flags</h4>
            <table class="w-full text-sm">
              <tr class="border-b border-white/10">
                <td class="py-2 text-violet-300 mono">-s, --status</td>
                <td class="py-2 text-gray-400">Filter by status (pending,blocked,in_progress,done,verified)</td>
              </tr>
              <tr class="border-b border-white/10">
                <td class="py-2 text-violet-300 mono">-p, --priority</td>
                <td class="py-2 text-gray-400">Filter by priority (high,medium,low)</td>
              </tr>
              <tr class="border-b border-white/10">
                <td class="py-2 text-violet-300 mono">--ready</td>
                <td class="py-2 text-gray-400">Show only tasks ready to start (unlocked + pending)</td>
              </tr>
              <tr class="border-b border-white/10">
                <td class="py-2 text-violet-300 mono">--blocked</td>
                <td class="py-2 text-gray-400">Show only blocked tasks</td>
              </tr>
              <tr class="border-b border-white/10">
                <td class="py-2 text-violet-300 mono">--active</td>
                <td class="py-2 text-gray-400">Show only in-progress tasks</td>
              </tr>
              <tr class="border-b border-white/10">
                <td class="py-2 text-violet-300 mono">-n, --limit</td>
                <td class="py-2 text-gray-400">Limit number of tasks shown</td>
              </tr>
              <tr class="border-b border-white/10">
                <td class="py-2 text-violet-300 mono">--json</td>
                <td class="py-2 text-gray-400">Output in JSON format</td>
              </tr>
            </table>
            <div class="mt-4 bg-black/40 rounded-lg p-4">
              <p class="text-xs text-gray-500 mb-2"># Examples</p>
              <code class="text-sm text-emerald-300 block">roady status --ready --limit 5</code>
              <code class="text-sm text-emerald-300 block mt-1">roady status -s in_progress,blocked -p high</code>
              <code class="text-sm text-emerald-300 block mt-1">roady status --json</code>
            </div>
          </div>

          <div class="glass rounded-xl p-6">
            <h3 class="text-lg font-semibold text-white mb-2">roady state rebuild</h3>
            <p class="text-gray-400 mb-4">Reconstruct <code class="mono text-violet-400">state.json</code> by replaying the event log. <code class="mono text-violet-400">events.jsonl</code> union-merges cleanly, but <code class="mono text-violet-400">state.json</code> is a whole-file document and will still conflict; it is derived data, so keep either side and replay.</p>
            <div class="bg-black/40 rounded-lg p-4 mb-4">
              <code class="text-sm text-gray-300 block">git checkout --ours .roady/state.json</code>
              <code class="text-sm text-gray-300 block mt-1">roady state rebuild --dry-run</code>
              <code class="text-sm text-gray-300 block mt-1">roady state rebuild</code>
            </div>
          </div>

          <div class="glass rounded-xl p-6">
            <h3 class="text-lg font-semibold text-white mb-2">roady audit trail</h3>
            <p class="text-gray-400 mb-4">Produce an evidence trail for a task, agent, or session: chain integrity, findings, evidence, and every recorded event. Exits non-zero when verification fails.</p>
            <div class="bg-black/40 rounded-lg p-4 mb-4">
              <code class="text-sm text-gray-300">roady audit trail [task-id] [flags]</code>
            </div>
            <h4 class="text-sm font-semibold text-gray-300 mb-2">Flags</h4>
            <table class="w-full text-sm">
              <tr class="border-b border-white/10">
                <td class="py-2 text-violet-300 mono">--agent</td>
                <td class="py-2 text-gray-400">Only events from this agent</td>
              </tr>
              <tr class="border-b border-white/10">
                <td class="py-2 text-violet-300 mono">--session</td>
                <td class="py-2 text-gray-400">Only events from this session ID</td>
              </tr>
            </table>
          </div>
        </div>
      </section>

      <!-- Git & MCP Commands -->
      <section id="integration-commands" class="mb-16">
        <h2 class="text-2xl font-bold text-white mb-6 flex items-center">
          <i data-lucide="plug" class="w-6 h-6 mr-3 text-indigo-400"></i>
          Git & MCP Commands
        </h2>
        <p class="text-gray-400 mb-6">Advance task state from commits and connect AI agents.</p>

        <div class="space-y-6">
          <div class="glass rounded-xl p-6">
            <h3 class="text-lg font-semibold text-white mb-2">roady git sync</h3>
            <p class="text-gray-400 mb-4">Scan recent git commits for task completion markers <code class="text-violet-300">[roady:task-id]</code>.</p>
            <div class="bg-black/40 rounded-lg p-4 mb-4">
              <code class="text-sm text-gray-300">roady git sync</code>
            </div>
            <div class="mt-4 bg-black/40 rounded-lg p-4">
              <p class="text-xs text-gray-500 mb-2"># Commit with task marker</p>
              <code class="text-sm text-emerald-300">git commit -m "Implement auth [roady:task-1]"</code>
            </div>
          </div>

          <div class="glass rounded-xl p-6">
            <h3 class="text-lg font-semibold text-white mb-2">roady mcp</h3>
            <p class="text-gray-400 mb-4">Start the Roady MCP (Model Context Protocol) server for AI agent integration.</p>
            <div class="bg-black/40 rounded-lg p-4 mb-4">
              <code class="text-sm text-gray-300">roady mcp [flags]</code>
            </div>
            <h4 class="text-sm font-semibold text-gray-300 mb-2">Flags</h4>
            <table class="w-full text-sm">
              <tr class="border-b border-white/10">
                <td class="py-2 text-violet-300 mono">--transport</td>
                <td class="py-2 text-gray-400">Transport to use: stdio, http, ws, grpc (default "stdio")</td>
              </tr>
              <tr class="border-b border-white/10">
                <td class="py-2 text-violet-300 mono">--addr</td>
                <td class="py-2 text-gray-400">Address for http/ws/grpc transports (default ":8080")</td>
              </tr>
            </table>
            <div class="mt-4 bg-black/40 rounded-lg p-4">
              <p class="text-xs text-gray-500 mb-2"># Examples</p>
              <code class="text-sm text-emerald-300 block">roady mcp</code>
              <code class="text-sm text-emerald-300 block mt-1">roady mcp --transport http --addr :8080</code>
              <code class="text-sm text-emerald-300 block mt-1">roady mcp --transport grpc --addr :50051</code>
            </div>
          </div>

        </div>
      </section>

      <!-- Advanced Commands -->
      <section id="advanced-commands" class="mb-16">
        <h2 class="text-2xl font-bold text-white mb-6 flex items-center">
          <i data-lucide="settings-2" class="w-6 h-6 mr-3 text-rose-400"></i>
          Advanced Commands
        </h2>
        <p class="text-gray-400 mb-6">Policies and audit integrity.</p>

        <div class="space-y-6">
          <div class="glass rounded-xl p-6">
            <h3 class="text-lg font-semibold text-white mb-2">roady policy check</h3>
            <p class="text-gray-400 mb-4">Check if the current plan complies with policies (WIP limits, dependencies).</p>
            <div class="bg-black/40 rounded-lg p-4">
              <code class="text-sm text-gray-300">roady policy check</code>
            </div>
          </div>

          <div class="glass rounded-xl p-6">
            <h3 class="text-lg font-semibold text-white mb-2">roady audit verify</h3>
            <p class="text-gray-400 mb-4">Verify the integrity of the project audit trail (hash-chain verification).</p>
            <div class="bg-black/40 rounded-lg p-4">
              <code class="text-sm text-gray-300">roady audit verify</code>
            </div>
          </div>

        </div>
      </section>

      <!-- Environment Variables -->
      <section id="environment" class="mb-16">
        <h2 class="text-2xl font-bold text-white mb-6 flex items-center">
          <i data-lucide="terminal" class="w-6 h-6 mr-3 text-gray-400"></i>
          Environment Variables
        </h2>
        <p class="text-gray-400 mb-6">Configure Roady behavior via environment variables.</p>

        <div class="glass rounded-xl p-6">
          <table class="w-full text-sm">
            <thead>
              <tr class="border-b border-white/20">
                <th class="py-3 text-left text-gray-300">Variable</th>
                <th class="py-3 text-left text-gray-300">Description</th>
              </tr>
            </thead>
            <tbody>
              <tr class="border-b border-white/10">
                <td class="py-3 text-violet-300 mono">ROADY_SESSION_ID</td>
                <td class="py-3 text-gray-400">Session recorded in the audit trail (generated per run when unset)</td>
              </tr>
              <tr class="border-b border-white/10">
                <td class="py-3 text-violet-300 mono">ROADY_AGENT</td>
                <td class="py-3 text-gray-400">Agent name recorded in the audit trail (auto-detected for Claude Code, Cursor, Codex, Gemini CLI)</td>
              </tr>
              <tr>
                <td class="py-3 text-violet-300 mono">ROADY_USER</td>
                <td class="py-3 text-gray-400">Task owner (<code class="mono text-violet-400">roady task mine</code>) and per-owner WIP limits</td>
              </tr>
            </tbody>
          </table>
        </div>
      </section>

      <!-- Data Files -->
      <section id="data-files" class="mb-16">
        <h2 class="text-2xl font-bold text-white mb-6 flex items-center">
          <i data-lucide="folder" class="w-6 h-6 mr-3 text-yellow-400"></i>
          Project Data Files
        </h2>
        <p class="text-gray-400 mb-6">Files stored in the <code class="text-violet-300">.roady/</code> directory.</p>

        <div class="glass rounded-xl p-6">
          <table class="w-full text-sm">
            <thead>
              <tr class="border-b border-white/20">
                <th class="py-3 text-left text-gray-300">File</th>
                <th class="py-3 text-left text-gray-300">Purpose</th>
              </tr>
            </thead>
            <tbody>
              <tr class="border-b border-white/10">
                <td class="py-3 text-violet-300 mono">spec.yaml</td>
                <td class="py-3 text-gray-400">Product specification (features, requirements)</td>
              </tr>
              <tr class="border-b border-white/10">
                <td class="py-3 text-violet-300 mono">spec.lock.json</td>
                <td class="py-3 text-gray-400">Pinned spec snapshot for drift detection</td>
              </tr>
              <tr class="border-b border-white/10">
                <td class="py-3 text-violet-300 mono">plan.json</td>
                <td class="py-3 text-gray-400">Task DAG with approval status</td>
              </tr>
              <tr class="border-b border-white/10">
                <td class="py-3 text-violet-300 mono">state.json</td>
                <td class="py-3 text-gray-400">Execution state (task statuses)</td>
              </tr>
              <tr class="border-b border-white/10">
                <td class="py-3 text-violet-300 mono">policy.yaml</td>
                <td class="py-3 text-gray-400">Governance (max_wip, allow_ai)</td>
              </tr>
              <tr>
                <td class="py-3 text-violet-300 mono">events.jsonl</td>
                <td class="py-3 text-gray-400">Immutable audit trail (hash-chained)</td>
              </tr>
            </tbody>
          </table>
        </div>
      </section>

      <!-- Back to top -->
      <div class="text-center">
        <a href="#" class="inline-flex items-center text-violet-400 hover:text-violet-300 transition-colors">
          <i data-lucide="arrow-up" class="w-4 h-4 mr-2"></i>
          Back to top
        </a>
      </div>
    </div>
  </main>

  <Footer />
</BaseLayout>
